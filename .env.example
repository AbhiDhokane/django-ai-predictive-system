# =============================================================================
# Django AI Predictive Maintenance System - Environment Configuration
# =============================================================================

# Django Secret Key and Debug mode
SECRET_KEY=django-insecure-ai-predictive-maintenance-system-change-in-production
DEBUG=True

# Database Configuration:
# Leave DATABASE_URL empty to automatically use SQLite (db.sqlite3) for local development.
# Provide a PostgreSQL URL for production (e.g. Neon, Render, Supabase, AWS RDS):
# DATABASE_URL=postgresql://user:password@ep-cool-cloud.neon.tech/maintenance?sslmode=require
DATABASE_URL=

# Monitored Fleet Configuration
MONITORED_MACHINES=M01,M02,M03
ALERT_RISK_THRESHOLD=75
ALERT_COOLDOWN_MINUTES=30
EMAIL_ALERTS_ENABLED=true

# SMTP Email Alert Service (Optional, for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
ALERT_RECIPIENTS=maintenance-ops@example.com
